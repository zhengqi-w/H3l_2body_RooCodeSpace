{
  "workflow": {
    "name": "h3l_unified_workflow",
    "stop_on_error": true,
    "order": [
      "bdt_spectrum",
      "topology_spectrum",
      "ct_extraction"
    ]
  },
  "paths": {
    "tasks_dir": "../Tasks",
    "generated_config_dir": "../Workflow/generated_configs",
    "log_dir": "../Workflow/logs"
  },
  "shared": {
    "enable_implicit_mt": true
  },
  "tasks": {
    "bdt_spectrum": {
      "enabled": true,
      "config": "bdt_spectrum.json",
      "override": {}
    },
    "topology_spectrum": {
      "enabled": true,
      "config": "topology_spectrum_CustomV0s.json",
      "override": {}
    },
    "ct_extraction": {
      "enabled": true,
      "config": "ct_extraction.json",
      "enable_implicit_mt": true,
      "override": {}
    }
  }
}
